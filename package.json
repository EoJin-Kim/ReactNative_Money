{
  "name": "react-native-template",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "prettier --write .",
    "start": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "clean:prebuild": "rm -rf ios android && expo prebuild --clean",
    "build:ios": "eas build --platform ios --profile production --local",
    "build:ios:dev": "eas build --platform ios --profile development --local",
    "build:android": "eas build --platform android --profile production --local",
    "build:android:dev": "eas build --platform android --profile development --local",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:ios:local": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:android:local": "eas submit --platform android --profile production",
    "deploy:ios": "npm run build:ios && npm run submit:ios",
    "deploy:android": "npm run build:android && npm run submit:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "swagger-sync": "ts-node --project scripts/swagger-sync/tsconfig.json scripts/swagger-sync/index.ts",
    "swagger-sync:dry-run": "ts-node --project scripts/swagger-sync/tsconfig.json scripts/swagger-sync/index.ts --dry-run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.4",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.3",
    "@tanstack/react-query": "^5.90.8",
    "axios": "^1.13.2",
    "babel-preset-expo": "^54.0.9",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.27",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.20",
    "expo-font": "~14.0.10",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-logs": "^5.5.0",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.18",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.7",
    "typescript": "~5.9.3"
  },
  "private": true
}
